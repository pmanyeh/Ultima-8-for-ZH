msgid "Ye know, the fish have stories to tell. "
msgstr ""

#. event 13 (justMoved)
msgctxt "bark 0410:08D3"
msgid "Ye should listen to 'em sometime. "
msgstr ""

#. event 13 (justMoved)
msgctxt "bark 0410:09A5"
