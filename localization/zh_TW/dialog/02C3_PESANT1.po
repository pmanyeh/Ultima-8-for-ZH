msgstr "城鎮巫師！"

# P13 batch 4
#. event 01 (use (talk))
msgctxt "bark 02C3:0278"
msgid "I can not talk with you now... "
msgstr "我現在不能跟你說話……"

# P13 batch 4
#. event 01 (use (talk))
msgctxt "bark 02C3:0354"
msgid "Hello... "
msgstr "你好……"

# P13 batch 4
#. event 01 (use (talk))
msgctxt "bark 02C3:0377"
msgid "Greetings... "
msgstr "你好……"

# P13 batch 4
#. event 01 (use (talk))
msgctxt "ask 02C3"
msgid "What is your name? "
msgstr "你叫什麼名字？"

# P13 batch 4
#. event 01 (use (talk))
msgctxt "ask 02C3"
msgid "bye "
msgstr "告辭"

# P13 batch 4
#. event 01 (use (talk)), after "What is your name? "
msgctxt "bark 02C3:048D"
msgid "I am sorry, but I never speak with strangers. "
msgstr "抱歉，我從不跟陌生人說話。"

# P13 batch 4
#. event 01 (use (talk)), after "What is your name? "
msgctxt "bark 02C3:04D8"
msgid "It is a quick way to loose your money and your life. "
msgstr "那是丟掉錢財和性命的捷徑。"

# P13 batch 4
#. event 01 (use (talk)), after "What is your name? "
msgctxt "bark 02C3:0546"
msgid "Who are you? Has Mordea sent you to question me? "
msgstr "你是誰？是莫爾迪亞派你來盤問我的嗎？"

# P13 batch 4
#. event 01 (use (talk)), after "What is your name? "
msgctxt "bark 02C3:05A3"
msgid "Ha! If you do not know who I am then you do not know what I have done! "
msgstr "哈！你要是不知道我是誰，那你也不會知道我做過什麼！"

# P13 batch 4
#. event 01 (use (talk)), after "bye "
msgctxt "bark 02C3:05F8"
msgid "Goodbye... "
msgstr "再見……"

# P13 batch 4
#. event 01 (use (talk)), after "bye "
msgctxt "bark 02C3:06CA"
msgid "Excuse me... "
msgstr "不好意思……"

# P13 batch 4
#. event 01 (use (talk)), after "bye "
msgctxt "bark 02C3:06ED"
msgid "Pardon me... "
msgstr "打擾一下……"

# P13 batch 4
#. event 01 (use (talk)), after "bye "
msgctxt "ask 02C3"
msgid "May I have a moment of your time? "
msgstr "能耽誤你一點時間嗎？"

# P13 batch 4
#. event 01 (use (talk)), after "bye "
msgctxt "ask 02C3"
msgid "bye. "
msgstr "告辭。"

# P13 batch 4
#. event 01 (use (talk)), after "May I have a moment of your time? "
msgctxt "bark 02C3:081D"
msgid "No! Who do you think you are? "
msgstr "不行！你以為你是誰？"

# P13 batch 4
#. event 01 (use (talk)), after "May I have a moment of your time? "
msgctxt "ask 02C3"
msgid "Why, I am the Avatar! "
msgstr "哎，我是聖者啊！"

# P13 batch 4
#. event 01 (use (talk)), after "May I have a moment of your time? "
msgctxt "bark 02C3:089D"
msgid "Get away from me! "
msgstr "離我遠一點！"

# P13 batch 4
#. event 01 (use (talk)), after "Why, I am the Avatar! "
msgctxt "bark 02C3:0923"
msgid "So. "
msgstr "所以呢。"

# P13 batch 4
#. event 01 (use (talk)), after "Why, I am the Avatar! "
msgctxt "bark 02C3:098B"
msgid "You wear such a repulsive costum and wish for me to give you a moment of MY time? "
msgstr "你穿著這麼噁心的衣服，還想要我把「我的」時間分給你？"

# P13 batch 4
#. event 01 (use (talk)), after "Why, I am the Avatar! "
msgctxt "bark 02C3:09B8"
msgid "Hmph! Go away, Avatar! "
msgstr "哼！走開，聖者！"

# P13 batch 4
#. event 01 (use (talk)), after "Hmph! Go away, Avatar! "
#. answer compared by the conversation code
msgctxt "ask 02C3"
msgid "Hmph! Go away, Avatar! "
msgstr "哼！走開，聖者！"

# P13 batch 4
#. event 01 (use (talk)), after "Hmph! Go away, Avatar! "
msgctxt "bark 02C3:0A23"
msgid "I don't think I enjoy talking to you. "
msgstr "我想我不喜歡跟你說話。"

# P13 batch 4
#. event 01 (use (talk)), after "bye. "
msgctxt "bark 02C3:0A74"
msgid "Hmph! "
msgstr "哼！"

# P13 batch 4
#. event 01 (use (talk)), after "bye. "
