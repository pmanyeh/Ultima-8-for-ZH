# P13 batch 5
#. event 13 (justMoved)
msgctxt "bark 041F:0139"
msgid "You will pay for that it with your life! "
msgstr "你要為此付出性命！"

# P13 batch 5
#. event 13 (justMoved)
msgctxt "bark 041F:0187"
msgid "Leave that alone. "
msgstr "別碰那個。"

# P13 batch 5
#. event 13 (justMoved)
msgctxt "bark 041F:01D4"
msgid "I said, leave my things alone! "
msgstr "我說了，別碰我的東西！"

# P13 batch 5
#. event 13 (justMoved)
msgctxt "bark 041F:022F"
msgid "I will kill you if you move my things again! "
msgstr "你要是再動我的東西，我就殺了你！"

# P13 batch 5
#. event 13 (justMoved)
msgctxt "bark 041F:025D"
msgid "Now you die! "
msgstr "現在你死定了！"

