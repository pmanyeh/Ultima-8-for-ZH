# P13 batch 5
#. event 01 (use (talk))
msgctxt "bark 041F:05E4"
msgid "What do you want, stranger? "
msgstr "你想幹嘛，陌生人？"

# P13 batch 5
#. event 01 (use (talk))
msgctxt "ask 041F"
msgid "Just your attention. "
msgstr "只是想引起你的注意。"

# P13 batch 5
#. event 01 (use (talk))
msgctxt "ask 041F"
msgid "I wish to speak to you. "
msgstr "我想跟你談談。"

# P13 batch 5
#. event 01 (use (talk))
msgctxt "ask 041F"
msgid "It's none of your business. "
msgstr "不關你的事。"

# P13 batch 5
#. event 01 (use (talk)), after "Just your attention. "
msgctxt "bark 041F:069B"
msgid "Who are you? "
msgstr "你是誰？"

# P13 batch 5
#. event 01 (use (talk)), after "I wish to speak to you. "
msgctxt "bark 041F:06E3"
msgid "Who are you? "
msgstr "你是誰？"

# P13 batch 5
#. event 01 (use (talk)), after "It's none of your business. "
msgctxt "bark 041F:0737"
msgid "Alright, then leave! "
msgstr "好啊，那就走！"

# P13 batch 5
#. event 01 (use (talk)), after "It's none of your business. "
#. sentence template: keep the {placeholders}
msgctxt "ask 041F"
msgid "I am called {name}."
msgstr "我叫{name}。"

# P13 batch 5
#. event 01 (use (talk)), after "It's none of your business. "
msgctxt "ask 041F"
msgid "I cannot tell you. "
msgstr "我不能告訴你。"

# P13 batch 5
#. event 01 (use (talk)), after "It's none of your business. "
msgctxt "ask 041F"
msgid "You would not understand. "
msgstr "你不會懂的。"

# P13 batch 5
#. event 01 (use (talk)), after "You would not understand. "
#. sentence template: keep the {placeholders}
msgctxt "bark 041F:0832"
msgid "Oh, greetings, {name}. I am Gorgrond. What do you need of me?"
msgstr "噢，你好，{name}。我是戈格隆德。你找我有什麼事？"

# P13 batch 5
#. event 01 (use (talk)), after "I cannot tell you. "
msgctxt "bark 041F:087D"
msgid "Why not? "
msgstr "為什麼不能？"

# P13 batch 5
#. event 01 (use (talk)), after "I cannot tell you. "
msgctxt "ask 041F"
msgid "If I did, I would have to kill you. "
msgstr "要是我說了，我就得殺了你。"

# P13 batch 5
#. event 01 (use (talk)), after "I cannot tell you. "
msgctxt "ask 041F"
msgid "What does it matter? "
msgstr "那有什麼關係？"

# P13 batch 5
#. event 01 (use (talk)), after "I cannot tell you. "
msgctxt "ask 041F"
msgid "I'm not sure. "
msgstr "我不確定。"

# P13 batch 5
#. event 01 (use (talk)), after "If I did, I would have to kill you. "
msgctxt "bark 041F:098C"
msgid "Ha, you'd find that hard to do. But I like you, you're funny. What do you want to know? "
msgstr "哈，你會發現那很難辦到。不過我喜歡你，你很有趣。你想知道什麼？"

# P13 batch 5
#. event 01 (use (talk)), after "What does it matter? "
msgctxt "bark 041F:09F8"
msgid "Well, what do I call you if I don't know your name? "
msgstr "嗯，不知道你的名字，我要怎麼叫你？"

# P13 batch 5
#. event 01 (use (talk)), after "What does it matter? "
#. sentence template: keep the {placeholders}
msgctxt "ask 041F"
msgid "Good question. I am {name}."
msgstr "好問題。我是{name}。"

# P13 batch 5
#. event 01 (use (talk)), after "What does it matter? "
msgctxt "ask 041F"
msgid "That's your problem. "
msgstr "那是你的問題。"

# P13 batch 5
#. event 01 (use (talk)), after "What does it matter? "
msgctxt "ask 041F"
msgid "You may call me Sir. "
msgstr "你可以叫我閣下。"

# P13 batch 5
#. event 01 (use (talk)), after "You may call me Sir. "
#. sentence template: keep the {placeholders}
msgctxt "bark 041F:0AD4"
msgid "Oh, greetings, {name}. I am Gorgrond. What do you need of me?"
msgstr "噢，你好，{name}。我是戈格隆德。你找我有什麼事？"

# P13 batch 5
#. event 01 (use (talk)), after "That's your problem. "
msgctxt "bark 041F:0B4B"
msgid "Fine then, I'll call you Dungbreath. Will that do? "
msgstr "那好，我就叫你臭糞之息。這樣行嗎？"

# P13 batch 5
#. event 01 (use (talk)), after "That's your problem. "
#. sentence template: keep the {placeholders}
msgctxt "ask 041F"
msgid "No, please call me {name}."
msgstr "不，請叫我{name}。"

# P13 batch 5
#. event 01 (use (talk)), after "That's your problem. "
msgctxt "ask 041F"
msgid "Yes, that will do nicely. "
msgstr "行，那很好。"

# P13 batch 5
#. event 01 (use (talk)), after "That's your problem. "
msgctxt "ask 041F"
msgid "No, I won't abide that. "
msgstr "不，我不能接受。"

# P13 batch 5
#. event 01 (use (talk)), after "That's your problem. "
msgctxt "ask 041F"
msgid "You will die for your insolence! "
msgstr "你會為你的無禮送命！"

# P13 batch 5
#. event 01 (use (talk)), after "Yes, that will do nicely. "
msgctxt "bark 041F:0C58"
msgid "Fine then. What do you want, Dungbreath? "
msgstr "那好。你要做什麼，臭糞之息？"

# P13 batch 5
#. event 01 (use (talk)), after "No, I won't abide that. "
msgctxt "bark 041F:0CD8"
msgid "Well, it's too bad you couldn't give me your name, Dungbreath. "
msgstr "嗯，可惜你不肯告訴我你的名字，臭糞之息。"

# P13 batch 5
#. event 01 (use (talk)), after "No, I won't abide that. "
#. sentence template: keep the {placeholders}
msgctxt "ask 041F"
msgid "I will! It's {name}."
msgstr "我說！我叫{name}。"

# P13 batch 5
#. event 01 (use (talk)), after "No, I won't abide that. "
msgctxt "ask 041F"
msgid "I don't care what you call me. "
msgstr "我不在乎你怎麼叫我。"

# P13 batch 5
#. event 01 (use (talk)), after "No, I won't abide that. "
msgctxt "ask 041F"
msgid "That's it! You die! "
msgstr "夠了！你死定了！"

# P13 batch 5
#. event 01 (use (talk)), after "That's it! You die! "
#. sentence template: keep the {placeholders}
msgctxt "bark 041F:0DB6"
msgid "Oh, greetings, {name}. I am Gorgrond. What do you need of me?"
msgstr "噢，你好，{name}。我是戈格隆德。你找我有什麼事？"

# P13 batch 5
#. event 01 (use (talk)), after "I don't care what you call me. "
msgctxt "bark 041F:0E33"
msgid "Good. Dungbreath it is. What do you seek here? "
msgstr "很好。那就叫臭糞之息了。你來這裡找什麼？"

# P13 batch 5
#. event 01 (use (talk)), after "That's it! You die! "
msgctxt "bark 041F:0ED9"
msgid "I do not think so, fool. My Sorcery will bring you to your knees, then I will feed you to my pet daemon! "
msgstr "我可不這麼想，蠢貨。我的巫術會讓你跪地求饒，然後我要把你拿去餵我養的惡魔！"

# P13 batch 5
#. event 01 (use (talk)), after "I do not think so, fool. My Sorcery will bring you to your knees, then I will feed you to my pet daemon! "
#. answer compared by the conversation code
msgctxt "ask 041F"
msgid "I do not think so, fool. My Sorcery will bring you to your knees, then I will feed you to my pet daemon! "
msgstr "我可不這麼想，蠢貨。我的巫術會讓你跪地求饒，然後我要把你拿去餵我養的惡魔！"

# P13 batch 5
#. event 01 (use (talk)), after "I do not think so, fool. My Sorcery will bring you to your knees, then I will feed you to my pet daemon! "
#. sentence template: keep the {placeholders}
msgctxt "bark 041F:0F43"
msgid "Fine then. What do you want, {name}?"
msgstr "那好。你要做什麼，{name}？"

# P13 batch 5
#. event 01 (use (talk)), after "You will die for your insolence! "
msgctxt "bark 041F:0FA8"
msgid "It is you who will die, peasant! "
msgstr "要死的是你，鄉巴佬！"

# P13 batch 5
#. event 01 (use (talk)), after "You may call me Sir. "
msgctxt "bark 041F:102A"
msgid "And you may call me your death, knave! "
msgstr "那你可以叫我你的死神，無賴！"

# P13 batch 5
#. event 01 (use (talk)), after "I'm not sure. "
msgctxt "bark 041F:1100"
msgid "Are you simple minded? Should I speak slower? Why... can't... you... tell... me... your... name? Oh, nevermind. What do you want? "
msgstr "你腦筋簡單嗎？要我說慢一點嗎？你……為……什……麼……不……能……告……訴……我……你……的……名……字？噢，算了。你要做什麼？"

# P13 batch 5
#. event 01 (use (talk)), after "You would not understand. "
msgctxt "bark 041F:11F3"
msgid "Do you take me for a fool? I am not a simplemind! My Sorcery is strong, as you will see if you anger me further. Go away now, before I loose my anger upon you. "
msgstr "你把我當傻瓜嗎？我可不是頭腦簡單的人！我的巫術很強，你要是再惹我生氣就會見識到。現在就走，免得我把怒火發在你身上。"

# P13 batch 5
#. event 01 (use (talk)), after "You would not understand. "
msgctxt "bark 041F:1421"
msgid "You die, fool! "
msgstr "去死吧，蠢貨！"

# P13 batch 5
#. event 01 (use (talk)), after "You would not understand. "
#. sentence template: keep the {placeholders}
msgctxt "bark 041F:14DC"
msgid "What, {varFA}? What do you want? "
msgstr "什麼事，{varFA}？你要做什麼？"

# P13 batch 5
#. event 01 (use (talk)), after "You would not understand. "
msgctxt "bark 041F:14DC"
msgid "Must you pester me? What do you want? "
msgstr "你非得來煩我嗎？你要做什麼？"

# P13 batch 5
#. event 01 (use (talk)), after "You would not understand. "
msgctxt "bark 041F:14DC"
msgid "I am not a sage. I have no great information to give to you. What do you want? "
msgstr "我又不是賢者，沒什麼了不起的情報可以給你。你要做什麼？"

# P13 batch 5
#. event 01 (use (talk)), after "You would not understand. "
msgctxt "bark 041F:14DC"
msgid "Go away! I do not wish to speak with you. "
msgstr "走開！我不想跟你說話。"

# P13 batch 5
#. event 01 (use (talk)), after "You would not understand. "
msgctxt "bark 041F:14DC"
msgid "I don't like you. Leave me be! "
msgstr "我不喜歡你。別來煩我！"

# P13 batch 5
#. event 01 (use (talk)), after "You would not understand. "
msgctxt "bark 041F:14DC"
msgid "Disturb me no longer. "
msgstr "別再打擾我了。"

# P13 batch 5
#. event 01 (use (talk)), after "You would not understand. "
#. sentence template: keep the {placeholders}
msgctxt "bark 041F:14DC"
msgid "Hello again, {varFA}. What do you want?"
msgstr "又見面了，{varFA}。你要做什麼？"

# P13 batch 5
#. event 01 (use (talk)), after "You would not understand. "
#. sentence template: keep the {placeholders}
msgctxt "bark 041F:14DC"
msgid "What do you want of me now, {varFA}?"
msgstr "你這次又要找我做什麼，{varFA}？"

# P13 batch 5
#. event 01 (use (talk)), after "You would not understand. "
msgctxt "bark 041F:14DC"
msgid "Greetings again. What do you need? "
msgstr "又見面了。你需要什麼？"

# P13 batch 5
#. event 01 (use (talk)), after "You would not understand. "
msgctxt "bark 041F:17C5"
msgid "Leave me, Dungbreath."
msgstr "離我遠點，臭糞之息。"

# P13 batch 5
#. event 01 (use (talk)), after "You would not understand. "
msgctxt "bark 041F:17C5"
msgid "Go away! "
msgstr "走開！"

# P13 batch 5
#. event 01 (use (talk)), after "You would not understand. "
msgctxt "bark 041F:17C5"
msgid "Have a care, Dungbreath. I am no gentle giant."
msgstr "小心點，臭糞之息。我可不是溫柔的巨人。"

# P13 batch 5
#. event 01 (use (talk)), after "You would not understand. "
msgctxt "bark 041F:17C5"
msgid "I can see that you will not survive long here, Dungbreath. Good luck to you. With your tongue, you'll need it."
msgstr "我看你在這裡活不久，臭糞之息。祝你好運。憑你那張嘴，你會需要好運的。"

# P13 batch 5
#. event 01 (use (talk)), after "You would not understand. "
msgctxt "bark 041F:17C5"
msgid "My temper will be kept only for so long. Go now while you still may. "
msgstr "我的脾氣可忍不了多久。趁還走得了，快走吧。"

# P13 batch 5
#. event 01 (use (talk)), after "You would not understand. "
msgctxt "bark 041F:17C5"
msgid "I have held my temper long enough!... No, I will not destroy you yet. But be warned, you have crossed the threshold into dangerous territory. Few have survived where you go. "
msgstr "我忍夠了！……不，我還不會毀了你。但我警告你，你已經踏進危險地帶了。走你這條路的人，很少有活下來的。"

# P13 batch 5
#. event 01 (use (talk)), after "You would not understand. "
msgctxt "bark 041F:17C5"
msgid "Goodbye, Dungbreath."
msgstr "再見，臭糞之息。"

# P13 batch 5
#. event 01 (use (talk)), after "You would not understand. "
msgctxt "bark 041F:17C5"
msgid "Farewell. "
msgstr "再會。"

# P13 batch 5
#. event 01 (use (talk)), after "You would not understand. "
msgctxt "bark 041F:17C5"
msgid "Farewell."
msgstr "再會。"

