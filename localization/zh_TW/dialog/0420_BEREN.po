# P13 batch 3
#. event 13 (justMoved)
msgctxt "bark 0420:01AD"
msgid "You little thief! I will destroy you! "
msgstr "你這小賊！我要毀了你！"

# P13 batch 3
#. event 13 (justMoved)
msgctxt "bark 0420:01FC"
msgid "Stop that. "
msgstr "住手。"

# P13 batch 3
#. event 13 (justMoved)
msgctxt "bark 0420:0241"
msgid "Leave my things alone! "
msgstr "別碰我的東西！"

# P13 batch 3
#. event 13 (justMoved)
msgctxt "bark 0420:028A"
msgid "This is your last warning! "
msgstr "這是最後一次警告！"

# P13 batch 3
#. event 13 (justMoved)
msgctxt "bark 0420:02C4"
msgid "That is all I will take! "
msgstr "我受夠了！"

# P13 batch 3
#. event 13 (justMoved)
msgctxt "bark 0420:035B"
msgid "I represent the entire Cabal here. "
msgstr "我在這裡代表的是整個密謀會。"

# P13 batch 3
#. event 13 (justMoved)
msgctxt "bark 0420:039F"
msgid "Do you know who I am? "
msgstr "你知道我是誰嗎？"

# P13 batch 3
#. event 13 (justMoved)
msgctxt "bark 0420:03FC"
msgid "I will kill you if you diturb my things again. "
msgstr "你要是再亂動我的東西，我就殺了你。"

# P13 batch 3
