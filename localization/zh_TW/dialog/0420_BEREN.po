#. event 01 (use (talk)), after "I cannot tell you. "
#. sentence template: keep the {placeholders}
msgctxt "bark 0420:1E93"
msgid "Please do return when you wish to discuss something, {name}."
msgstr "想談什麼的時候，請務必再來，{name}。"

# P13 batch 3
#. event 01 (use (talk)), after "I cannot tell you. "
#. sentence template: keep the {placeholders}
msgctxt "bark 0420:1F03"
msgid "If I can be of assistance to you in future, {name}, don't hesitate to ask."
msgstr "往後若有我能幫忙的地方，{name}，儘管開口。"

# P13 batch 3
#. event 01 (use (talk)), after "I cannot tell you. "
