# P13 batch 3
#. event 01 (use (talk)), after "I cannot tell you. "
#. sentence template: keep the {placeholders}
msgctxt "bark 0420:18C4"
msgid "Farewell, {name}."
msgstr "再會，{name}。"

# P13 batch 3
#. event 01 (use (talk)), after "I cannot tell you. "
#. sentence template: keep the {placeholders}
msgctxt "bark 0420:1918"
msgid "I will see you anon. Fare well until then, {name}."
msgstr "改天再見。在那之前保重，{name}。"

# P13 batch 3
#. event 01 (use (talk)), after "I cannot tell you. "
#. sentence template: keep the {placeholders}
msgctxt "bark 0420:197D"
msgid "Goodbye. May the Fire of Pyros always burn brightly within you, {name}."
msgstr "再見。願派羅斯之火永遠在你心中熊熊燃燒，{name}。"

