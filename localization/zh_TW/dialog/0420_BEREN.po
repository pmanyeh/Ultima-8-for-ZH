# P13 batch 3
#. event 01 (use (talk)), after "I cannot tell you. "
#. sentence template: keep the {placeholders}
msgctxt "bark 0420:1AB9"
msgid "I tire of our dicussion. Farewell, {name}."
msgstr "我厭倦了我們的談話。再會，{name}。"

# P13 batch 3
#. event 01 (use (talk)), after "I cannot tell you. "
#. sentence template: keep the {placeholders}
msgctxt "bark 0420:1B15"
msgid "Come back when you really wish to speak to me, {name}."
msgstr "等你真的想跟我說話時再來吧，{name}。"

# P13 batch 3
