# P13 batch 6
#. said for PYROS (006D), event 01 (use (talk))
msgctxt "bark 057C:088A"
msgid "Vardion!"
msgstr "瓦爾迪恩！"

# P13 batch 6
#. said for PYROS (006D), event 01 (use (talk))
msgctxt "bark 057C:088A"
msgid "Bane!"
msgstr "貝恩！"

# P13 batch 6
#. said for PYROS (006D), event 01 (use (talk))
msgctxt "bark 057C:088A"
msgid "No, of course not Master. "
msgstr "不，當然不是，大師。"

# P13 batch 6
#. said for PYROS (006D), event 01 (use (talk))
msgctxt "bark 057C:088A"
msgid "Well, just a little. "
msgstr "嗯，只有一點點。"

# P13 batch 6
#. said for PYROS (006D), event 01 (use (talk))
msgctxt "bark 057C:088A"
msgid "Hmmm? What do you mean? "
msgstr "嗯？你是什麼意思？"

# P13 batch 6
#. said for PYROS (006D), event 01 (use (talk))
msgctxt "bark 057C:088A"
msgid "Nothing Gorgrond. Just be quiet. "
msgstr "沒什麼，戈格隆德。安靜點就是了。"

# P13 batch 6
#. said for PYROS (006D), event 01 (use (talk))
msgctxt "bark 057C:088A"
msgid "Yes, Master. "
msgstr "是，大師。"

# P13 batch 6
#. said for PYROS (006D), event 01 (use (talk))
msgctxt "bark 057C:088A"
msgid "Vardion..."
msgstr "瓦爾迪恩……"

# P13 batch 6
#. said for PYROS (006D), event 01 (use (talk))
msgctxt "bark 057C:088A"
msgid "Bane..."
msgstr "貝恩……"

# P13 batch 6
#. said for PYROS (006D), event 01 (use (talk))
msgctxt "bark 057C:088A"
msgid "Provide the -Acolyte- with a candle. "
msgstr "給這位「學徒」一根蠟燭。"

# P13 batch 6
#. said for PYROS (006D), event 01 (use (talk))
msgctxt "bark 057C:088A"
msgid "I told him... "
msgstr "我跟他說過了……"

# P13 batch 6
#. said for PYROS (006D), event 01 (use (talk))
msgctxt "bark 057C:088A"
msgid "Do it. "
msgstr "照做。"

# P13 batch 6
#. said for PYROS (006D), event 01 (use (talk))
msgctxt "bark 057C:088A"
msgid "Thank you, First Acolyte. "
msgstr "謝謝你，第一學徒。"

# P13 batch 6
#. said for PYROS (006D), event 01 (use (talk))
msgctxt "bark 057C:088A"
msgid "You are most gracious, Master. "
msgstr "您真是寬宏大量，大師。"

# P13 batch 6
#. said for PYROS (006D), event 01 (use (talk))
msgctxt "bark 057C:088A"
msgid "Resume your position. "
msgstr "回到你的位置上。"

# P13 batch 6
#. said for PYROS (006D), event 01 (use (talk))
msgctxt "bark 057C:088A"
msgid "Fool! I will do it myself. "
msgstr "蠢貨！我自己來。"

# P13 batch 6
#. said for PYROS (006D), event 01 (use (talk))
msgctxt "bark 057C:088A"
msgid "I said kneel, Acolyte! "
msgstr "我說了跪下，學徒！"

# P13 batch 6
#. said for PYROS (006D), event 01 (use (talk))
msgctxt "bark 057C:088A"
msgid "Acolytes... you are dismissed. "
msgstr "學徒們……你們可以退下了。"

# P13 batch 6
#. said for PYROS (006D), event 01 (use (talk))
msgctxt "bark 057C:088A"
msgid "Except for you. "
msgstr "你除外。"

# P13 batch 6
#. said for PYROS (006D), event 01 (use (talk))
msgctxt "bark 057C:088A"
msgid "Yes, you. "
msgstr "對，就是你。"

# P13 batch 6
#. said for PYROS (006D), event 01 (use (talk))
msgctxt "bark 057C:088A"
msgid "Wait, I'm going... "
msgstr "等等，我這就走……"

# P13 batch 6
#. said for PYROS (006D), event 01 (use (talk))
msgctxt "bark 057C:088A"
msgid "Yes, you are. "
msgstr "對，你這就走。"

# P13 batch 6
#. said for PYROS (006D), event 01 (use (talk))
msgctxt "bark 057C:088A"
msgid "If I could just ask... "
msgstr "能不能讓我問一下……"

# P13 batch 6
#. said for PYROS (006D), event 01 (use (talk))
msgctxt "bark 057C:088A"
msgid "I said begone! "
msgstr "我說了滾！"

# P13 batch 6
#. said for PYROS (006D), event 01 (use (talk))
msgctxt "bark 057C:088A"
msgid "Master, I must speak with you... "
msgstr "大師，我得跟您談談……"

# P13 batch 6
#. said for PYROS (006D), event 01 (use (talk))
msgctxt "bark 057C:088A"
msgid "No, you musn't. Begone! "
msgstr "不，你不必。滾吧！"

# P13 batch 6
#. said for PYROS (006D), event 01 (use (talk))
msgctxt "bark 057C:088A"
msgid "Farewell, Acolyte. "
msgstr "再會，學徒。"

# P13 batch 6
#. said for PENT (007C), event 01 (use (talk))
msgctxt "bark 057C:088A"
msgid "Something's wrong. "
msgstr "有點不對勁。"

# P13 batch 6
#. said for PENT (007C), event 01 (use (talk))
msgctxt "bark 057C:088A"
msgid "I've come for you, Sorcerer! "
msgstr "我是來找你的，巫師！"

# P13 batch 6
#. said for BOTTLE (00B4), event 01 (use (talk))
msgctxt "bark 057C:088A"
msgid "hic... "
msgstr "嗝……"

