msgstr "選擇施法者。"

# P13 batch 1
#. said for EXCUTION (0483), event 07 (hatch)
msgctxt "bark 057C:088A"
msgid "No!!!!  "
msgstr "不！！！！"

# P13 batch 1
#. said for EXCUTION (0483), event 07 (hatch)
msgctxt "bark 057C:088A"
msgid "Back, woman! "
msgstr "退後，女人！"

# P13 batch 1
#. said for EXCUTION (0483), event 07 (hatch)
