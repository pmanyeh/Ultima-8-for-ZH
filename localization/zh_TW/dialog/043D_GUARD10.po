# P13 batch 1
#. event 01 (use (talk)), after "Who are you? "
msgctxt "bark 043D:03A8"
msgid "Who are you to ask me such? "
msgstr "你憑什麼問我這種事？"

# P13 batch 1
#. event 01 (use (talk)), after "Who are you? "
msgctxt "bark 043D:03E7"
msgid "'Tis I who should demand your name, cur! "
msgstr "該問名字的人是我，你這條狗！"

# P13 batch 1
#. event 01 (use (talk)), after "What is your duty? "
#. answer compared by the conversation code
msgctxt "ask 043D"
msgid "What is your duty? "
msgstr "你的職責是什麼？"

# P13 batch 1
#. event 01 (use (talk)), after "What is your duty? "
msgctxt "bark 043D:0478"
msgid "My job is to guard to watch out for odds folks like you. "
msgstr "我的工作就是盯著你這種怪人。"

# P13 batch 1
#. event 01 (use (talk)), after "Where am I? "
#. answer compared by the conversation code
msgctxt "ask 043D"
msgid "Where am I? "
msgstr "這是哪裡？"

# P13 batch 1
#. event 01 (use (talk)), after "Where am I? "
msgctxt "bark 043D:04EB"
msgid "You are in the palace, of course! "
msgstr "你當然是在宮殿裡！"

# P13 batch 1
#. event 01 (use (talk)), after "Where am I? "
msgctxt "bark 043D:053C"
msgid "What makes you think I have time for this kind of talk? "
msgstr "你憑什麼以為我有空聊這種事？"

# P13 batch 1
#. event 01 (use (talk)), after "Where am I? "
msgctxt "bark 043D:0588"
msgid "Continue on your way before I decide to put you away. "
msgstr "趁我還沒決定把你關起來之前，繼續趕你的路吧。"

# P13 batch 1
#. event 01 (use (talk)), after "goodbye "
msgctxt "bark 043D:05D2"
msgid "About time. "
msgstr "總算要走了。"
