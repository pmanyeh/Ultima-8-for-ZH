msgid "Necromancy. "
msgstr "死靈術。"

# P13 batch 3
#. event 10 (enterFastArea), after "Necromancy. "
msgctxt "bark 0421:0AA8"
msgid "Do you wish to buy Bone, Executioner's Hood, or Blackmoor? "
