# P13 batch 2
#. event 00 (look)
msgctxt "bark 040A:00B3"
msgid "the body of Orlok "
msgstr "歐洛克的遺體"

# P13 batch 2
#. event 00 (look)
msgctxt "bark 040A:00EA"
msgid "Orlok the barkeep "
msgstr "酒保歐洛克"

# P13 batch 2
#. event 00 (look)
msgctxt "bark 040A:0112"
msgid "Orlok"
msgstr "歐洛克"

# P13 batch 2
#. event 00 (look)
msgctxt "bark 040A:013D"
msgid "barkeep "
msgstr "酒保"

# P13 batch 2
#. event 00 (look)
msgctxt "bark 040A:015D"
msgid "man "
msgstr "男人"

# P13 batch 2
#. event 11 (leaveFastArea)
msgctxt "bark 040A:02CC"
msgid "Beren! I am assaulted! "
msgstr "貝倫！有人襲擊我！"

# P13 batch 2
#. event 11 (leaveFastArea)
msgctxt "bark 040A:051B"
msgid "Somethin' to wet yer whistle, mate? "
msgstr "來點東西潤潤喉嚨吧，伙計？"

# P13 batch 2
#. event 11 (leaveFastArea)
msgctxt "bark 040A:05E7"
msgid "Need something, stranger...? "
msgstr "需要什麼嗎，陌生人……？"

# P13 batch 2
#. event 11 (leaveFastArea)
msgctxt "bark 040A:0610"
msgid "Need something? "
msgstr "需要什麼嗎？"

# P13 batch 2
#. event 11 (leaveFastArea)
msgctxt "bark 040A:0699"
msgid "No loitering! "
msgstr "別在這兒閒晃！"

# P13 batch 2
#. event 11 (leaveFastArea)
msgctxt "bark 040A:06E4"
msgid "Buy somethin' or leave! "
msgstr "要嘛買點東西，要嘛走人！"

# P13 batch 2
#. event 11 (leaveFastArea)
msgctxt "bark 040A:0733"
msgid "You are lookin' thirsty. "
msgstr "你看起來渴得很哪。"

# P13 batch 2
#. event 11 (leaveFastArea)
msgctxt "bark 040A:07BC"
msgid "Like to hear a story? "
msgstr "想聽個故事嗎？"

# P13 batch 2
#. event 11 (leaveFastArea)
msgctxt "bark 040A:0833"
msgid "Perhaps later. "
msgstr "待會兒再說吧。"

# P13 batch 2
#. event 11 (leaveFastArea)
msgctxt "bark 040A:08CB"
msgid "Need more clean glasses. "
msgstr "乾淨的杯子不夠了。"

# P13 batch 2
#. event 11 (leaveFastArea)
msgctxt "bark 040A:0925"
msgid "Hmmmm..."
msgstr "嗯……"

# P13 batch 2
#. event 11 (leaveFastArea)
msgctxt "bark 040A:098D"
msgid "To be a sailor again. "
msgstr "真想再當一回水手啊。"

# P13 batch 2
#. event 11 (leaveFastArea)
msgctxt "bark 040A:09D3"
msgid "Curse this leg. "
msgstr "這條該死的腿。"

# P13 batch 2
#. event 11 (leaveFastArea)
msgctxt "bark 040A:0A23"
msgid "This floor needs sweepin'. "
msgstr "這地板該掃一掃了。"

# P13 batch 2
#. event 11 (leaveFastArea)
msgctxt "bark 040A:0A83"
msgid "I'll clean it later. "
msgstr "待會兒再來清。"

# P13 batch 2
#. event 11 (leaveFastArea)
msgctxt "bark 040A:0AE3"
msgid "Argh, scratched meself with me hook! "
msgstr "哎唷，被自己的鐵鉤刮到了！"

# P13 batch 2
#. event 11 (leaveFastArea)
msgctxt "bark 040A:0B84"
msgid "Hurry it up there, Jenna! "
msgstr "動作快點，珍娜！"

# P13 batch 2
#. event 11 (leaveFastArea)
#. sentence template: keep the {placeholders}
msgctxt "bark 040A:0D2B"
msgid "Righto, matey. That'll be {call_0C74} black chips."
msgstr "好嘞，伙計。一共{call_0C74}枚黑曜石幣。"

# P13 batch 2
#. event 11 (leaveFastArea)
msgctxt "bark 040A:0DE3"
msgid "We got Tenebraen Ale, o' course, vintage Blackwine, a feisty little brew called the Hurricane, Breath o' the Spirit, and the hard stuff ... Cloven Hoof. "
msgstr "咱們有泰尼伯瑞麥酒，那是當然的；還有陳年黑酒、一種叫颶風酒的烈性小酒、靈息酒，以及最烈的那款……魔蹄酒。"

# P13 batch 2
#. event 11 (leaveFastArea)
msgctxt "ask 040A"
msgid "Tenebraen Ale "
msgstr "泰尼伯瑞麥酒"

# P13 batch 2
#. event 11 (leaveFastArea)
msgctxt "ask 040A"
msgid "Blackwine "
msgstr "黑酒"

# P13 batch 2
#. event 11 (leaveFastArea)
msgctxt "ask 040A"
msgid "Hurricane "
msgstr "颶風酒"

# P13 batch 2
#. event 11 (leaveFastArea)
msgctxt "ask 040A"
msgid "Breath o' Spirit "
msgstr "靈息酒"

# P13 batch 2
#. event 11 (leaveFastArea)
msgctxt "ask 040A"
msgid "Cloven Hoof "
msgstr "魔蹄酒"

# P13 batch 2
#. event 11 (leaveFastArea)
msgctxt "ask 040A"
msgid "Nothing, thank you. "
msgstr "不用了，謝謝。"

# P13 batch 2
#. event 11 (leaveFastArea), after "Tenebraen Ale "
msgctxt "bark 040A:0ED5"
msgid "That'll be two glassies. And a deal at twice that price! "
msgstr "兩枚黑曜石幣。就算賣兩倍價錢都算便宜！"

# P13 batch 2
#. event 11 (leaveFastArea), after "Blackwine "
msgctxt "bark 040A:0F46"
msgid "Three obsidians, and ye'll not be disappointed. "
msgstr "三枚黑曜石幣，包你不會失望。"

# P13 batch 2
#. event 11 (leaveFastArea), after "Hurricane "
msgctxt "bark 040A:0FD0"
msgid "That'll be two ladies, then. And ye won't find it cheaper anywhere else! "
msgstr "那就兩枚黑曜石幣。別的地方可找不到更便宜的了！"

# P13 batch 2
#. event 11 (leaveFastArea), after "Breath o' Spirit "
msgctxt "bark 040A:106F"
msgid "Two ladies, then. I haven't raised me prices in all the years I've been here, ye know. "
msgstr "那就兩枚黑曜石幣。你知道嗎，我在這兒這麼多年，從來沒漲過價。"

# P13 batch 2
#. event 11 (leaveFastArea), after "Cloven Hoof "
msgctxt "bark 040A:1105"
msgid "Five black pieces. I know it's a bit pricey, but I think ye won't be disappointed. "
msgstr "五枚黑曜石幣。我知道是貴了點，不過我想你不會失望的。"

# P13 batch 2
#. event 11 (leaveFastArea), after "Nothing, thank you. "
msgctxt "bark 040A:1164"
msgid "Well, suit yerself. "
msgstr "好吧，隨你便。"

# P13 batch 2
#. event 11 (leaveFastArea), after ""
msgctxt "bark 040A:11AF"
msgid "Oh, a quiet one. Well, suit yerself. "
msgstr "喲，是個悶葫蘆。好吧，隨你便。"

# P13 batch 2
#. event 11 (leaveFastArea), after ""
msgctxt "ask 040A"
msgid "Here is the amount. "
msgstr "錢在這裡。"

# P13 batch 2
#. event 11 (leaveFastArea), after ""
msgctxt "ask 040A"
msgid "No, thank you. "
msgstr "不用了，謝謝。"

# P13 batch 2
#. event 11 (leaveFastArea), after ""
msgctxt "ask 040A"
msgid "Put it on my tab. "
msgstr "記在我的帳上。"

# P13 batch 2
#. event 11 (leaveFastArea), after ""
msgctxt "ask 040A"
msgid "Open a tab for me, please. "
msgstr "請幫我開個帳戶。"

# P13 batch 2
#. event 11 (leaveFastArea), after "Open a tab for me, please. "
msgctxt "bark 040A:12F1"
msgid "Aye, I'll do that. But remember this, I collects late accounts with me hook! "
msgstr "好，就這麼辦。不過記住了，拖欠的帳我可是用鐵鉤來收的！"

# P13 batch 2
#. event 11 (leaveFastArea), after "Open a tab for me, please. "
msgctxt "bark 040A:13A2"
msgid "I can na' give ye yer drink with yer hands full. Put some of that down an' I'll be happy to serve ye! "
msgstr "你兩手都滿了，我沒法把酒給你。先放下一些東西，我很樂意招待你！"

# P13 batch 2
#. event 11 (leaveFastArea), after "Here is the amount. "
msgctxt "bark 040A:141B"
msgid "Thank ye, thank ye. "
msgstr "謝啦，謝啦。"

# P13 batch 2
#. event 11 (leaveFastArea), after "Here is the amount. "
msgctxt "bark 040A:1496"
msgid "Sorry mate, I can't give ye any more credit. I'm afeared ye'll just have to go thirsty. "
msgstr "抱歉啦伙計，不能再讓你賒帳了。恐怕你只能乾渴著了。"

# P13 batch 2
#. event 11 (leaveFastArea), after "Here is the amount. "
msgctxt "bark 040A:1504"
msgid "Hmmm, ye haven't enough stones, so I'll just put it on yer tab. "
msgstr "嗯……你的黑曜石幣不夠，那我就先記在你帳上。"

# P13 batch 2
#. event 11 (leaveFastArea), after "Here is the amount. "
msgctxt "bark 040A:1583"
msgid "Ye can't take a drink when yer hands are full! Come back after ye set some o' that down! "
msgstr "你兩手滿滿的，怎麼拿酒！先放下一些東西再來！"

# P13 batch 2
#. event 11 (leaveFastArea), after "No, thank you. "
msgctxt "bark 040A:160A"
msgid "All a bit too rich for ye? Well, I'm sure ye'll find a well around somewhere, ha,ha,ha! "
msgstr "都太貴了，喝不起？好吧，我相信你在附近總找得到一口井，哈哈哈！"

# P13 batch 2
#. event 11 (leaveFastArea), after "Put it on my tab. "
#. sentence template: keep the {placeholders}
msgctxt "bark 040A:16B3"
msgid "Fine, that brings your tab to {num} black stones. Would you like to pay that now?"
msgstr "好，這樣你的帳就累積到{num}枚黑曜石幣了。要現在付清嗎？"

# P13 batch 2
#. event 11 (leaveFastArea), after "Put it on my tab. "
msgctxt "ask 040A"
msgid "Yes "
msgstr "好"

# P13 batch 2
#. event 11 (leaveFastArea), after "Put it on my tab. "
msgctxt "ask 040A"
msgid "No "
msgstr "不要"

# P13 batch 2
#. event 11 (leaveFastArea), after "Yes "
msgctxt "bark 040A:1796"
msgid "It's not goin' ta waste, No siree, Why, I'll get a new patch er two with this. "
msgstr "這錢可不會白花，絕對不會。嘿，我可以拿它去買一兩個新眼罩。"

# P13 batch 2
#. event 11 (leaveFastArea), after "Yes "
msgctxt "bark 040A:17E7"
msgid "Why with this I can get some polish fer me peg. "
msgstr "嘿，有了這些，我就能給我的木腿買點亮光油了。"

# P13 batch 2
#. event 11 (leaveFastArea), after "Yes "
msgctxt "bark 040A:183D"
msgid "This is just enough to get me hook sharpened, it is! "
msgstr "這剛好夠我把鐵鉤磨利，正好！"

# P13 batch 2
#. event 11 (leaveFastArea), after "Yes "
msgctxt "bark 040A:18B4"
msgid "What do ye mean? Ye haven't enough there to pay yer tab! Well, then ye'll just go thirsty! "
msgstr "你這是什麼意思？你身上的錢根本不夠付帳！好吧，那你就乾渴著吧！"

# P13 batch 2
#. event 11 (leaveFastArea), after "Yes "
msgctxt "bark 040A:195E"
msgid "I'll gladly take yer stones, but ye can't hold a drink with yer hands full. Put some o' that down and I'll sell ye a drink! "
msgstr "你的黑曜石幣我很樂意收下，但你兩手滿了，拿不了酒。先放下一些東西，我再賣你一杯！"

# P13 batch 2
#. event 11 (leaveFastArea), after "No "
msgctxt "bark 040A:19D3"
msgid "All right. Here's yer drink. We'll settle yer tab later. "
msgstr "好吧。這是你的酒。帳以後再算。"

# P13 batch 2
#. event 11 (leaveFastArea), after "No "
msgctxt "bark 040A:1A3C"
msgid "Yer gonna have to put some o' that stuff down a'fore ye can have this drink. "
msgstr "你得先放下一些東西，才能拿這杯酒。"

# P13 batch 2
#. event 11 (leaveFastArea), after "No "
#. sentence template: keep the {placeholders}
msgctxt "bark 040A:1AC7"
msgid "Yer tab is up to {num}. Before I can serve ye, ye'll have to pay it off."
msgstr "你的帳已經累積到{num}了。你得先付清，我才能再招待你。"

# P13 batch 2
#. event 11 (leaveFastArea), after "No "
msgctxt "ask 040A"
msgid "All right, I'll pay. "
msgstr "好吧，我付。"

# P13 batch 2
#. event 11 (leaveFastArea), after "No "
msgctxt "ask 040A"
msgid "Sorry, I won't pay. "
msgstr "抱歉，我不付。"

# P13 batch 2
#. event 11 (leaveFastArea), after "All right, I'll pay. "
msgctxt "bark 040A:1B97"
msgid "Thank ye, mate. I knew ye was good fer the stone! "
msgstr "謝啦，伙計。我就知道你付得起！"

# P13 batch 2
#. event 11 (leaveFastArea), after "All right, I'll pay. "
msgctxt "bark 040A:1C0B"
msgid "Ye haven't enough stone there, mate. Ye'll have to drink water, then, until ye can pay me. "
msgstr "你的黑曜石幣不夠啊，伙計。在付得出錢之前，你就只能喝水了。"

# P13 batch 2
#. event 11 (leaveFastArea), after "Sorry, I won't pay. "
msgctxt "bark 040A:1C6A"
msgid "Then, I'm sorry, ye won't drink either! "
msgstr "那就抱歉了，你也別想喝！"

# P13 batch 2
#. event 11 (leaveFastArea), after ""
msgctxt "bark 040A:1CB4"
msgid "When ye make up yer mind, just hollar. "
msgstr "等你拿定主意，喊一聲就行。"

# P13 batch 2
#. event 01 (use (talk))
msgctxt "ask 040A"
msgid "Goodbye. "
msgstr "再見。"

# P13 batch 2
#. event 01 (use (talk))
msgctxt "ask 040A"
msgid "Tell me of your tales. "
msgstr "說說你的故事。"

# P13 batch 2
#. event 01 (use (talk))
msgctxt "ask 040A"
msgid "Tell me of Tenebrae. "
msgstr "說說泰尼伯瑞。"

# P13 batch 2
#. event 01 (use (talk))
msgctxt "ask 040A"
msgid "I'll have a drink. "
msgstr "我要喝一杯。"

# P13 batch 2
#. event 01 (use (talk))
msgctxt "ask 040A"
msgid "What do you do? "
msgstr "你是做什麼的？"

# P13 batch 2
#. event 01 (use (talk))
msgctxt "ask 040A"
msgid "What is your name? "
msgstr "你叫什麼名字？"

# P13 batch 2
#. event 01 (use (talk))
msgctxt "ask 040A"
msgid "What is my tab? "
msgstr "我欠了多少帳？"

# P13 batch 2
#. event 01 (use (talk))
msgctxt "bark 040A:1E9A"
msgid "Greetin's, stranger. What kin I do fer ye? "
msgstr "你好啊，陌生人。有什麼能為你效勞的？"

# P11 POC: dynamic strings (proposed terms, see authority.tsv)
#. event 01 (use (talk))
#. sentence template: keep the {placeholders}
msgctxt "bark 040A:1F16"
msgid "Greetings again {varF7}. Will ye be havin' another {call_0BCF}?"
msgstr "又見面了，{varF7}。要再來一杯{call_0BCF}嗎？"

# P13 batch 2
#. event 01 (use (talk))
msgctxt "ask 040A"
msgid "Yes, I believe so. "
msgstr "好，我想是吧。"

# P13 batch 2
#. event 01 (use (talk))
msgctxt "ask 040A"
msgid "No, I'm not thirsty. "
msgstr "不，我不渴。"

# P13 batch 2
# P11 POC: dynamic strings (proposed terms, see authority.tsv)
#. event 01 (use (talk))
#. sentence template: keep the {placeholders}
msgctxt "bark 040A:1FA0"
msgid "Greetin's again, {varF7}. What's yer poison?"
msgstr "又見面了，{varF7}。想來點什麼毒藥？"

# P13 batch 2
#. event 01 (use (talk))
msgctxt "ask 040A"
msgid "What do you mean by poison? "
msgstr "你說的毒藥是什麼意思？"

# P13 batch 2
#. event 01 (use (talk))
#. sentence template: keep the {placeholders}
msgctxt "bark 040A:2057"
msgid "'Tis good ta see ye again, {varF7}. How kin I help ye?"
msgstr "真高興又見到你，{varF7}。有什麼能幫你的？"

# P13 batch 2
#. event 01 (use (talk))
#. sentence template: keep the {placeholders}
msgctxt "bark 040A:208F"
msgid "What do ye need, {varF7}?"
msgstr "你需要什麼，{varF7}？"

# P13 batch 2
#. event 01 (use (talk)), after "What is my tab? "
#. sentence template: keep the {placeholders}
msgctxt "bark 040A:218A"
msgid "Well, let's see. Yer total is {num}. Would ye like to pay that now?"
msgstr "嗯，我看看。你一共欠{num}。要現在付清嗎？"

# P13 batch 2
#. event 01 (use (talk)), after "What is my tab? "
msgctxt "ask 040A"
msgid "I'll pay my tab. "
msgstr "我要付帳。"

# P13 batch 2
#. event 01 (use (talk)), after "What is my tab? "
msgctxt "ask 040A"
msgid "No, not now. "
msgstr "不，現在不付。"

# P13 batch 2
#. event 01 (use (talk)), after "No, not now. "
msgctxt "bark 040A:224D"
msgid "All right, but remember, I don't extend yer credit over 20 blacks. "
msgstr "好吧，不過記住，賒帳最多只能到二十枚黑曜石幣。"

# P13 batch 2
#. event 01 (use (talk)), after "I'll pay my tab. "
msgctxt "bark 040A:230A"
msgid "Will wonders never cease? And may I go to a watery grave if me ears don't deceive me... "
msgstr "奇蹟還真是層出不窮啊！要是我的耳朵沒騙我，就讓我葬身海底吧……"

# P13 batch 2
#. event 01 (use (talk)), after "I'll pay my tab. "
msgctxt "bark 040A:2365"
msgid "But I'll gladly take yer stone and thank ye! "
msgstr "不過你的錢我就樂意收下了，謝啦！"

# P13 batch 2
#. event 01 (use (talk)), after "I'll pay my tab. "
#. sentence template: keep the {placeholders}
msgctxt "bark 040A:23D1"
msgid "But I see they do. Yer short on stone, {varF7}, Come back when ye've enough."
msgstr "看來我的耳朵確實騙了我。你的錢不夠啊，{varF7}，等湊夠了再來吧。"

# P13 batch 2
#. event 01 (use (talk)), after "What is your name? "
msgctxt "bark 040A:247C"
msgid "Me name's Orlok. And what might be yours, friend? "
msgstr "我叫歐洛克。那你呢，朋友？"

# P13 batch 2
#. event 01 (use (talk)), after "What is your name? "
#. sentence template: keep the {placeholders}
msgctxt "ask 040A"
msgid "My name is {name}."
msgstr "我叫{name}。"

# P13 batch 2
#. event 01 (use (talk)), after "What is your name? "
msgctxt "ask 040A"
msgid "I can't give you my name. "
msgstr "我不能告訴你我的名字。"

# P13 batch 2
#. event 01 (use (talk)), after "I can't give you my name. "
#. sentence template: keep the {placeholders}
msgctxt "bark 040A:2523"
msgid "Well met then, {name}. 'Tis a fine name indeed. Stay a while and listen to me tales."
msgstr "那就幸會了，{name}。真是個好名字。坐一會兒，聽聽我的故事吧。"

# P13 batch 2
#. event 01 (use (talk)), after "I can't give you my name. "
msgctxt "bark 040A:2681"
msgid "Fine. 'Tis yer choice whether or not to give me yer name. I'll not ask again, stranger. But would ye care ta hear some o' me tales? "
msgstr "好吧。要不要告訴我名字是你的事，我不會再問了，陌生人。不過，你想聽聽我的故事嗎？"

# P13 batch 2
#. event 01 (use (talk)), after "What do you do? "
msgctxt "bark 040A:2765"
msgid "Well, now, I be a bartender. 'Tis why I offered ye a drink. "
msgstr "嘿，我是個酒保啊。所以我才請你喝一杯嘛。"

# P13 batch 2
#. event 01 (use (talk)), after "What do you do? "
msgctxt "bark 040A:27B1"
msgid "Well, now, I be a bartender. Kin I get ye a drink? "
msgstr "嘿，我是個酒保啊。要給你來一杯嗎？"

# P13 batch 2
#. event 01 (use (talk)), after "No, I'm not thirsty. "
msgctxt "bark 040A:2871"
msgid "Well, then, perhaps ye'd care to hear one of me tales. "
msgstr "那麼，也許你會想聽聽我的故事。"

# P13 batch 2
#. event 01 (use (talk)), after "What do you mean by poison? "
#. sentence template: keep the {placeholders}
msgctxt "bark 040A:291B"
msgid "It's just another way o' sayin' drink, {varF7}."
msgstr "那只是「酒」的另一種說法啦，{varF7}。"

# P13 batch 2
#. event 01 (use (talk)), after "I'll have a drink. "
msgctxt "bark 040A:2A75"
msgid "Would ye be likin' another o' the same? "
msgstr "要再來一杯一樣的嗎？"

# P13 batch 2
#. event 01 (use (talk)), after "I'll have a drink. "
msgctxt "bark 040A:2AAB"
msgid "Will ye be havin' the usual? "
msgstr "老樣子嗎？"

# P13 batch 2
#. event 01 (use (talk)), after "I'll have a drink. "
msgctxt "ask 040A"
msgid "What are the choices? "
msgstr "有哪些可以選？"

# P13 batch 2
#. event 01 (use (talk)), after "I'll have a drink. "
msgctxt "bark 040A:2B02"
msgid "Well, what'll ye have? "
msgstr "那麼，你要喝什麼？"

# P13 batch 2
#. event 01 (use (talk)), after "Nothing, thank you. "
msgctxt "bark 040A:2BFB"
msgid "Suit yerself. But ye don't know what yer missing. We serve only the finest spirits here. Well, how about a tale or two to pass yer time? "
msgstr "隨你便。不過你不知道自己錯過了什麼。我們這兒只賣最上等的酒。那麼，聽一兩個故事打發時間怎麼樣？"

# P13 batch 2
#. event 01 (use (talk)), after "Tell me of your tales. "
msgctxt "bark 040A:2DCA"
msgid "Aye, me bucco. I know a right frightful tale about a ghost that walks the hills above Tenebrae. Would ye like to hear that 'en? "
msgstr "好啊，老弟。我知道一個挺嚇人的故事，說的是一個在泰尼伯瑞後山遊蕩的幽靈。想聽這個嗎？"

# P13 batch 2
#. event 01 (use (talk)), after "Tell me of your tales. "
msgctxt "ask 040A"
msgid "That I would. "
msgstr "我想聽。"

# P13 batch 2
#. event 01 (use (talk)), after "Tell me of your tales. "
msgctxt "ask 040A"
msgid "No, but thank you. "
msgstr "不了，不過謝謝你。"

# P13 batch 2
#. event 01 (use (talk)), after "Tell me of your tales. "
msgctxt "bark 040A:2E5F"
msgid "Aye, matey, yer a right good fellow. Now, what tales would ye like to hear? "
msgstr "好啊，伙計，你真是個好傢伙。那麼，你想聽哪個故事？"

# P13 batch 2
#. event 01 (use (talk)), after "Tell me of your tales. "
msgctxt "ask 040A"
